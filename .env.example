# ForecastGuard Backend Environment Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEMO_MODE=true
DATA_PROVIDER=demo

# ML & Metric Thresholds
BUST_PERCENTILE=90
MIN_ERROR_THRESHOLD_MM=10.0
MODEL_PATH=models/forecastguard_xgb_calibrated.joblib
DATA_DIR=data

# Database Configuration (SQLite default for standalone, switchable to Postgres)
DATABASE_URL=sqlite:///./data/forecastguard.db
# For PostgreSQL on Render / Docker:
# DATABASE_URL=postgresql://forecastguard:password@dpg-...:5432/forecastguard_db

# CORS Configuration (comma-separated origins allowed to call this API)
CORS_ORIGINS=https://forecastguard-3ebv.onrender.com,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:8000
