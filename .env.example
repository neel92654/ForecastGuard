# ForecastGuard Environment Configuration
# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEMO_MODE=true
DATA_PROVIDER=demo

# ML & Metric Thresholds
BUST_PERCENTILE=90
MIN_ERROR_THRESHOLD_MM=10.0
MODEL_PATH=models/forecastguard_xgb_calibrated.joblib
DATA_DIR=data

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite:///./data/forecastguard.db
# For PostgreSQL in Docker / Production:
# DATABASE_URL=postgresql://forecastguard:forecastguard_password@localhost:5432/forecastguard_db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
